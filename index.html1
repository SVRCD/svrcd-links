<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Shasta Valley RCD | Connect</title>

  <meta
    name="description"
    content="Connect with the Shasta Valley Resource Conservation District."
  >

  <style>
    :root {
      --green: #5f8f8b;
      --green-dark: #3f6f6a;
      --cream: #f5f1e8;
      --paper: #fffdf8;
      --text: #26332f;
      --muted: #66716d;
      --line: #d8d2c8;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, Helvetica, sans-serif;
      background: var(--cream);
      color: var(--text);
    }

    .page {
      width: min(92%, 470px);
      margin: 0 auto;
      padding: 34px 0 28px;
      text-align: center;
    }

    .logo {
      display: block;
      width: min(82%, 320px);
      height: auto;
      margin: 0 auto 18px;
    }

    .intro {
      margin-bottom: 28px;
    }

    .intro p {
      margin: 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.5;
    }

    .links {
      display: grid;
      gap: 13px;
    }

    .link {
      display: block;
      width: 100%;
      padding: 16px 18px;
      border: 1px solid var(--green-dark);
      border-radius: 7px;

      background: var(--paper);
      color: var(--green-dark);

      text-decoration: none;
      font-size: 16px;
      font-weight: 700;
      line-height: 1.25;

      box-shadow: 0 2px 7px rgba(38, 51, 47, 0.06);

      transition:
        background 0.15s ease,
        color 0.15s ease,
        transform 0.15s ease;
    }

    .link:hover,
    .link:focus-visible {
      background: var(--green-dark);
      color: white;
      transform: translateY(-1px);
    }

    .link.featured {
      background: var(--green-dark);
      color: white;
      border-color: var(--green-dark);
      padding: 18px;
    }

    .link.featured:hover,
    .link.featured:focus-visible {
      background: #345d59;
    }

    .link span {
      display: block;
      margin-top: 5px;
      font-size: 13px;
      font-weight: 400;
      opacity: 0.88;
    }

    .social-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 13px;
    }

    .footer {
      margin-top: 30px;
      padding-top: 18px;

      border-top: 1px solid var(--line);

      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }

    @media (max-width: 380px) {
      .page {
        width: 90%;
        padding-top: 24px;
      }

      .logo {
        width: 88%;
      }

      .social-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <main class="page">

    <img
      class="logo"
      src="svrcd-logo.webp"
      alt="Shasta Valley Resource Conservation District"
    >

    <section class="intro">
      <p>
        Resources, updates, and ways to connect.
      </p>
    </section>

    <section class="links">

      <!--
        MOBILE IRRIGATION LAB

        When you get the form link,
        replace the # below with the actual URL.
      -->

      <a
        class="link featured"
        href="#"
      >
        Mobile Irrigation Lab

        <span>
          Get more information or join the interest list
        </span>
      </a>


      <!-- MAIN WEBSITE -->

      <a
        class="link"
        href="https://www.svrcd.org/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit Our Website
      </a>


      <!-- CONTACT PAGE -->

      <a
        class="link"
        href="https://www.svrcd.org/contact-us"
        target="_blank"
        rel="noopener noreferrer"
      >
        Contact SVRCD
      </a>


      <!-- SOCIAL MEDIA -->

      <div class="social-row">

        <a
          class="link"
          href="https://www.instagram.com/shastavalleyrcd/?utm_source=ig_web_button_share_sheet"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
        </a>


        <a
          class="link"
          href="https://www.facebook.com/p/Shasta-Valley-Resource-Conservation-District-100064596587595/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Facebook
        </a>

      </div>

    </section>


    <footer class="footer">

      Shasta Valley Resource Conservation District
      <br>

      Siskiyou County, California

    </footer>

  </main>

</body>

</html>
