<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Shasta Valley RCD</title>

  <style>
    body {
      margin: 0;
      background: #f5f1e8;
      font-family: Arial, Helvetica, sans-serif;
      color: #26332f;
    }

    .page {
      max-width: 470px;
      margin: 0 auto;
      padding: 35px 20px;
      text-align: center;
    }

    .logo {
      width: 300px;
      max-width: 90%;
      height: auto;
      margin-bottom: 20px;
    }

    .subtitle {
      font-size: 15px;
      color: #66716d;
      margin-bottom: 30px;
    }

    .button {
      display: block;
      width: 100%;
      box-sizing: border-box;
      margin: 12px 0;
      padding: 17px 18px;

      background: white;
      color: #3f6f6a;

      border: 1px solid #3f6f6a;
      border-radius: 6px;

      text-decoration: none;
      font-size: 16px;
      font-weight: bold;
    }

    .button:hover {
      background: #3f6f6a;
      color: white;
    }

    .featured {
      background: #3f6f6a;
      color: white;
    }

    .featured span {
      display: block;
      margin-top: 5px;
      font-size: 13px;
      font-weight: normal;
    }

    .socials {
      display: flex;
      gap: 12px;
    }

    .socials .button {
      flex: 1;
    }

    .footer {
      margin-top: 30px;
      padding-top: 18px;
      border-top: 1px solid #d8d2c8;

      font-size: 12px;
      line-height: 1.5;
      color: #66716d;
    }

    @media screen and (max-width: 400px) {
      .socials {
        display: block;
      }
    }
  </style>
</head>

<body>

  <div class="page">

    <img
      src="SVRCD__LOGO_LOCKUP_1_SECONDARY_COLOR.webp"
      alt="Shasta Valley Resource Conservation District"
      class="logo"
    >

    <div class="subtitle">
      Resources, updates, and ways to connect.
    </div>

    <!-- Mobile Irrigation Lab -->
    <a href="#" class="button featured">
      Mobile Irrigation Lab
      <span>Get more information or join the interest list</span>
    </a>

    <!-- Website -->
    <a
      href="https://www.svrcd.org/"
      class="button"
      target="_blank"
    >
      Visit Our Website
    </a>

    <!-- Contact -->
    <a
      href="https://www.svrcd.org/contact-us"
      class="button"
      target="_blank"
    >
      Contact SVRCD
    </a>

    <!-- Social Media -->
    <div class="socials">

      <a
        href="https://www.instagram.com/shastavalleyrcd/?utm_source=ig_web_button_share_sheet"
        class="button"
        target="_blank"
      >
        Instagram
      </a>

      <a
        href="https://www.facebook.com/p/Shasta-Valley-Resource-Conservation-District-100064596587595/"
        class="button"
        target="_blank"
      >
        Facebook
      </a>

    </div>

    <div class="footer">
      Shasta Valley Resource Conservation District<br>
      Siskiyou County, California
    </div>

  </div>

</body>
</html>
